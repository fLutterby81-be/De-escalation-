# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Without a key the app still works, using its built-in instructions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Gemini model used for the micro-instructions.
# Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL="gemini-3.5-flash-lite"

# PORT: Optional. Port the server listens on. Defaults to 3000.
# PORT=3000
